# --- Security ---
JWT_SECRET_KEY=replace-with-a-long-random-string
# Real bug found live during overnight QA: if this is left unset,
# app/core/crypto.py derives the credential-encryption key FROM
# JWT_SECRET_KEY -- so rotating that secret (e.g. after generating a real
# one to replace this placeholder) silently and permanently orphans every
# already-saved provider/AI credential, since they were encrypted under a
# key derived from the old secret. Set your own independent random value
# here (generate one the same way you generate JWT_SECRET_KEY) BEFORE
# saving any provider credentials, so the two secrets can be rotated
# independently later without breaking stored credentials.
ENCRYPTION_MASTER_KEY=replace-with-a-different-long-random-string
# Metasploit RPC password (Pentest Suite's gated exploit-validation feature).
# msfrpcd binds to 127.0.0.1 only inside the backend container -- unreachable
# from outside it regardless -- but override this if that ever changes.
MSF_RPC_PASSWORD=replace-with-a-long-random-string

# --- Ollama (primary AI backend -- local, no API key/quota) ---
# host.docker.internal resolves to the host machine from inside the backend
# container (Docker Desktop on Windows/Mac). Set OLLAMA_MODEL to whatever
# `ollama list` shows once your pull finishes.
AI_BACKEND=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# --- AWS Bedrock (Claude) -- alternative AI backend, set AI_BACKEND=bedrock to use ---
# BEDROCK_API_KEY is a bearer token from IAM -> Users -> Security credentials
# -> "Generate API Key" (preferred). AWS_ACCESS_KEY_ID/SECRET are the older
# SigV4 fallback, only used if BEDROCK_API_KEY is blank.
BEDROCK_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Use the "global." cross-region inference profile prefix if your account's
# region (e.g. ap-southeast-1) has no in-region/Geo profile for this model --
# check the model's Regional availability table in the Bedrock console.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Google Gemini (alternative AI backend, set AI_BACKEND=gemini to use) ---
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.0-flash

# --- Anthropic direct API (alternative AI backend, set AI_BACKEND=anthropic to use) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-5-20250929

# --- Groq (alternative AI backend, set AI_BACKEND=groq to use) ---
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile

# --- OpenAI / ChatGPT (alternative AI backend, set AI_BACKEND=openai to use) ---
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini

# --- Kimi / Moonshot AI (alternative AI backend, set AI_BACKEND=kimi to use) ---
# Default model deliberately avoids Moonshot's "thinking"-mode models --
# forced tool_choice (which this app always uses) 400s on those.
KIMI_API_KEY=
KIMI_MODEL_ID=kimi-k2.5

# --- DeepSeek (alternative AI backend, set AI_BACKEND=deepseek to use) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_ID=deepseek-v4-flash

# --- xAI / Grok (alternative AI backend, set AI_BACKEND=xai to use) ---
# Not to be confused with Groq (api.groq.com) -- this is xAI's Grok.
XAI_API_KEY=
XAI_MODEL_ID=grok-4.6

# --- Mistral AI (alternative AI backend, set AI_BACKEND=mistral to use) ---
MISTRAL_API_KEY=
MISTRAL_MODEL_ID=mistral-small-2506

# --- OpenRouter (alternative AI backend, set AI_BACKEND=openrouter to use) ---
# A meta-router giving access to hundreds of underlying models from many
# companies through one OpenAI-compatible API -- see
# https://openrouter.ai/models for the full catalog.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=openai/gpt-4o

# --- Free-tier providers (real connectors) ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
NVD_API_KEY=
ABUSECH_AUTH_KEY=

# --- Paid providers (stub connectors -- add key to activate) ---
HYBRID_ANALYSIS_API_KEY=
CENSYS_PERSONAL_ACCESS_TOKEN=
CENSYS_ORGANIZATION_ID=
PHISHTANK_API_KEY=
