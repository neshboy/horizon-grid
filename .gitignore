.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.pyc
.venv/
.venv_test/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Node / Next.js ---
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# --- Documentation build pipeline: the scripts/configs under documentation/build/
# ARE tracked (they're the only way to regenerate every PDF/DOCX in documentation/
# from a fresh clone) -- only their generated intermediate output is ignored here.
documentation/build/node_modules/
documentation/build/*.html
documentation/build/*-pass1.pdf
documentation/build/pass1.pdf
documentation/build/sections.json
documentation/build/raw-screenshots/
documentation/build/tmp_*.js
documentation/build/walkthrough*.js
documentation/build/chaos-*.js
documentation/build/verify-dashboard-ws7.js
documentation/pages_png/
documentation/manual.txt

# --- Release artifacts (regenerate via windows/installer.iss / linux/build-deb.sh; ship as GitHub Release assets, not git blobs) ---
release/

# --- Ad-hoc QA/test debris ---
backend/qa_halluc_out_*.json
backend/celerybeat-schedule
/nul

# --- Logs / OS / IDE ---
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
